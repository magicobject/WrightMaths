{
  "name": "wrightmaths",
  "version": "1.0.0",
  "description": "Wright Maths Tuition static site — feature tests for nav, page content and 404 handling.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "book:audio": "node scripts/book-audio.mjs",
    "book:review": "node scripts/audio-review.mjs",
    "book:docx": "npm run build && node scripts/build-docx.mjs",
    "book:pdf-check": "node scripts/pdf-check.mjs",
    "test": "npm run build && npm run test:unit && playwright test",
    "test:unit": "node --test test-unit/*.test.mjs",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "serve": "tsx test/support/static-server.ts",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicobject/WrightMaths.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/magicobject/WrightMaths/issues"
  },
  "homepage": "https://github.com/magicobject/WrightMaths#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "docx": "9.15.3",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
